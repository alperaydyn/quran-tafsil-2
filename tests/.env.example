# tafsil.net — Test Suite Environment Variables
# cp .env.example .env and fill in for local/staging/VPS runs

# API tests
API_URL=http://localhost:4000

# E2E (Playwright) web tests
SITE_URL=https://new.tafsil.net

# Direct DB validation (data-pipeline / schema tests)
DATABASE_URL_DIRECT=postgres://tafsil:CHANGE_ME@localhost:5432/tafsil_db

# Auth test fixtures (do not use real user credentials)
TEST_JWT_SECRET=CHANGE_ME_RANDOM_SECRET_MIN_32_CHARS
