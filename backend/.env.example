# ═══════════════════════════════════════════════════════════
# tafsil.net — Backend Environment Variables Template
# ═══════════════════════════════════════════════════════════
# Bu dosyayı .env.production (veya .env.staging) olarak kopyalayın
# ve gerçek değerleri girin. Asla Git'e commit etmeyin!
#
# Kullanım: cp .env.example .env.production
# ═══════════════════════════════════════════════════════════

# ─── Uygulama ────────────────────────────────────────────
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ─── PostgreSQL ──────────────────────────────────────────
POSTGRES_DB=tafsil_db
POSTGRES_USER=tafsil
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5432

# PgBouncer üzerinden bağlantı (önerilen)
DATABASE_URL=postgres://tafsil:CHANGE_ME@localhost:6432/tafsil_db

# Doğrudan PostgreSQL bağlantısı (migration için)
DATABASE_URL_DIRECT=postgres://tafsil:CHANGE_ME@localhost:5432/tafsil_db

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ve Kimlik Doğrulama ─────────────────────────────
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# Apple Sign-In
APPLE_CLIENT_ID=net.tafsil.app
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
APPLE_PRIVATE_KEY_PATH=./secrets/apple-auth-key.p8

# Google Sign-In (OAuth 2.0)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# ─── OpenRouter (LLM Gateway) ───────────────────────────
OPENROUTER_API_KEY=sk-or-xxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model tercihleri
LLM_MODEL_DEEP=anthropic/claude-3.5-sonnet
LLM_MODEL_FAST=google/gemini-flash-1.5

# ─── ElevenLabs (TTS — Türkçe Meal Seslendirmesi) ───────
ELEVENLABS_API_KEY=xxxx

# ─── Sentry (Hata İzleme) ───────────────────────────────
SENTRY_DSN=https://xxxx@sentry.io/xxxx
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Push Notifications ─────────────────────────────────
# Apple Push Notification Service (APNs)
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_KEY_PATH=./secrets/apns-auth-key.p8
APNS_BUNDLE_ID=net.tafsil.app

# Firebase Cloud Messaging (Android)
FCM_PROJECT_ID=tafsil-app
FCM_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# ─── Cloudflare ──────────────────────────────────────────
CLOUDFLARE_ZONE_ID=xxxx
CLOUDFLARE_API_TOKEN=xxxx

# ─── Rate Limiting ──────────────────────────────────────
RATE_LIMIT_GENERAL=60          # Genel API: dakikada max istek
RATE_LIMIT_LLM=10              # LLM endpoint: dakikada max istek

# ─── CORS ────────────────────────────────────────────────
CORS_ORIGINS=https://new.tafsil.net,https://tafsil.net,https://staging.tafsil.net

# ─── Ses Dosyaları ───────────────────────────────────────
AUDIO_BASE_PATH=/opt/tafsil/audio
AUDIO_BASE_URL=https://api.tafsil.net/audio
