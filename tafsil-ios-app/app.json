{
  "expo": {
    "name": "Tafsil",
    "slug": "tafsil-net",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tafsilnet",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#3F5F86",
    "ios": {
      "bundleIdentifier": "net.tafsil.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "CFBundleDevelopmentRegion": "tr",
        "CFBundleAllowMixedLocalizations": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "package": "net.tafsil.app",
      "adaptiveIcon": {
        "backgroundColor": "#F4F1EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1EA",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "microphonePermission": "Ezber Stüdyosu'nda kendi tilavetinizi sesli olarak doğrulayabilmeniz için mikrofonunuza erişim gereklidir. Ses kaydı yalnızca cihazınızda işlenir."
        }
      ],
      "expo-asset",
      "expo-sqlite"
    ],
    "extra": {
      "apiUrl": "https://api.tafsil.net/api/v1",
      "audioBaseUrl": "https://audio.tafsil.net",
      "privacyPolicyUrl": "https://tafsil.net/gizlilik",
      "supportEmail": "merhaba@tafsil.net",
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
