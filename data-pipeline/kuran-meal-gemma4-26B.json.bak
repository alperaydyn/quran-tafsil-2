  },
  {
    "surah_number": 68,
    "ayah_number": 19,
    "surah_name": "Kalem",
    "ayah_translation": "Derken, onlar uykuda iken, Rabbin tarafından onun üzerinde bir azap (dolaşıcı) dolaşıverdi.",
    "sentence_blocks": [
