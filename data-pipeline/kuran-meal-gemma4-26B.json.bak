    "model": "google/gemini-2.5-flash-lite"
  },
  {
    "surah_number": 36,
    "ayah_number": 13,
    "surah_name": "Yasin",
    "ayah_translation": "Onlara o şehir halkını misal ver. Hani onlara elçiler gelmişti.",
    "sentence_blocks": [
      {
        "arabic_text": "وَٱضْرِبْ لَهُم مَّثَلًا أَصْحَٰبَ ٱلْقَرْيَةِ",
