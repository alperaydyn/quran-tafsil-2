  {
    "surah_number": 36,
    "ayah_number": 11,
    "surah_name": "Yasin",
    "ayah_translation": "Sen ancak zikre uyan ve görünmeden Rab'den korkan kimseyi uyarabilirsin. İşte onu bir bağışlanma ve büyük bir ecirle müjdele.",
    "sentence_blocks": [
      {
        "arabic_text": "إِنَّمَا تُنذِرُ مَنِ ٱتَّبَعَ ٱلذِّكْرَ",
        "display_text": "innamā tunẕiru mani-ttabaʿa ẕ-ẕikra",
        "turkish_meaning": "Sen ancak zikre uyan kimseyi uyarabilirsin"
