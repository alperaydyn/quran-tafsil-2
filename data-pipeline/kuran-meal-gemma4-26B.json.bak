  },
  {
    "surah_number": 68,
    "ayah_number": 18,
    "surah_name": "Kalem",
    "ayah_translation": "Onlar şöyle derlerdi: 'Bizim ekinlerimize sabahleyin mutlaka uğrayın, eğer (meyvelerini) devşirecekseniz!'",
    "sentence_blocks": [
