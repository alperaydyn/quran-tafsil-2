  {
    "surah_number": 68,
    "ayah_number": 17,
    "surah_name": "Kalem",
    "ayah_translation": "Biz onlara, bahçe sahiplerini denediğimiz gibi denedik. Hani onlar, sabahleyin bahçenin ürününü devşireceklerine yemin etmişlerdi.",
    "sentence_blocks": [
      {
        "arabic_text": "إِنَّا بَلَوْنَٰهُمْ كَمَا بَلَوْنَآ أَصْحَٰبَ ٱلْجَنَّةِ",
        "display_text": "innā balavnāhum kamā balavnā aṣḥāba l-jannati",
        "turkish_meaning": "Biz onlara, bahçe sahiplerini denediğimiz gibi denedik"
      },
      {
        "arabic_text": "إِذْ أَقْسَمُوا۟ لَيَصْرِمُنَّهَا مُصْبِحِينَ",
        "display_text": "iż aqsamū layṣrimunnahā muṣbiḥīn",
