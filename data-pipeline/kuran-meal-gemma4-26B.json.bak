  {
    "surah_number": 36,
    "ayah_number": 12,
    "surah_name": "Yasin",
    "ayah_translation": "Şüphesiz ölüleri biz diriltiriz ve onların (geleceğe) gönderdikleri şeyleri ve bıraktıkları eserleri yazarız. Zaten biz her şeyi apaçık bir 'imam'da (bilgi kaynağında, ana kitapta) sayıp tespit etmişizdir.",
    "sentence_blocks": [
      {
        "arabic_text": "إِنَّا نَحْنُ نُحْىِ ٱلْمَوْتَىٰ",
        "display_text": "ʾinnā naḥnu nuḥyī l-mawtā",
        "turkish_meaning": "Şüphesiz ölüleri biz diriltiriz"
      },
      {
        "arabic_text": "وَنَكْتُبُ مَا قَدَّمُوا۟ وَءَاثَٰرَهُمْ",
