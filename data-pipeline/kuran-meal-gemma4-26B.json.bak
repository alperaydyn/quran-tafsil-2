  {
    "surah_number": 36,
    "ayah_number": 9,
    "surah_name": "Yasin",
    "ayah_translation": "Ve onlardan önde bir sed, arkalarından da bir sed yaptık. Böylece onları örtü altına aldık, artık onlar görmezler.",
    "sentence_blocks": [
      {
        "arabic_text": "وَجَعَلْنَا مِنۢ بَيْنِ أَيْدِيهِمْ سَدًّا",
